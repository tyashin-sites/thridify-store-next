{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-thridify-store-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "17f05c72d9ce425e906ce09bbf036c33"
    }
  ],
  // ISR revalidation queue (open-next.config.ts `queue: doQueue`). Without it
  // stale pages are never regenerated — tyashin-platform CLAUDE.md §12c-bis.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "site-thridify-store-next" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    "TYASHIN_API_URL": "https://website-api.tyashin.com",
    "TYASHIN_STOREFRONT_URL": "https://website-api.tyashin.com/api/v1/public/ecommerce",
    "PROJECT_ID": "6a8eb18ca64c21a0d29ad9e1",
    "SITE_DOMAIN": "thridify-website-mt9w4pa0.sites.tyashin.com",
    "ROBOTS_NOINDEX": "true"
  }
}
